# Copy to .env and edit. Never commit .env (it is in .gitignore).

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (use a URL-safe password: letters, digits, - and _) ---
POSTGRES_USER=gateway
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=gateway

# Local gateway connecting to Docker-hosted infrastructure.
# POSTGRES_PASSWORD must match the initialized database password.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5433/${POSTGRES_DB}
REDIS_URL=redis://127.0.0.1:6379/0

PRODUCT_SERVICE_URL=http://127.0.0.1:8001
ORDER_SERVICE_URL=http://127.0.0.1:8002

# --- JWT --- generate with:  openssl rand -hex 32   (must be >= 32 characters)
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=30

# --- Rate limiting ---
# token_bucket | sliding_window
RATE_LIMIT_ALGORITHM=token_bucket
# Per API key:
TOKEN_BUCKET_CAPACITY=100
TOKEN_BUCKET_REFILL_RATE=10
SLIDING_WINDOW_LIMIT=100
SLIDING_WINDOW_SECONDS=60
# Per-user limit = per-key limit x this factor (a user may hold several keys)
USER_LIMIT_MULTIPLIER=5
# Per client IP (gateway + management endpoints)
IP_RATE_LIMIT_REQUESTS=200
IP_RATE_LIMIT_WINDOW_SECONDS=60
# Per client IP on /auth/register and /auth/login (brute-force protection)
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Number of trusted reverse proxies in front of the gateway. Keep 0 unless you run one;
# otherwise clients could spoof their IP via X-Forwarded-For.
TRUSTED_PROXY_COUNT=0

# --- Upstream timeouts (seconds) ---
UPSTREAM_TIMEOUT_SECONDS=5
UPSTREAM_CONNECT_TIMEOUT_SECONDS=2
